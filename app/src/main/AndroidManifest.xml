<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 11+ 包可见性：StatusProvider 用 getPackagesForUid() 反查高德 UID
        对应的包名；没有这条 queries 声明时，目标包对模块不可见，校验会误判失败。
    -->
    <queries>
        <package android:name="com.autonavi.minimap" />
    </queries>

    <application
        android:name=".QuietMapApp"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.QuietMap">

        <!--
            开关页把配置写进框架的 remote preferences。此前只写模块自己的 MODE_PRIVATE，
            目标进程读不到，导致所有开关都不生效。
            authority 必须是 <applicationId>.XposedService，这是 libxposed service 的约定；
            官方 XposedProvider 是 final 且其回调入口是包内可见，所以直接用它，不包一层。
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            诊断数据通道：高德进程命中钩子后 call 进来。
            方向不能反过来——remote prefs 和 openRemoteFile 在目标进程都是只读。
            authority 与 StatusProvider.AUTHORITY 必须一致。
        -->
        <provider
            android:name=".StatusProvider"
            android:authorities="${applicationId}.qmreport"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            MainActivity 同时承担两个入口：
            1. MODULE_SETTINGS：LSPosed 管理器里「打开」模块时使用；
            2. activity-alias LauncherEntry 的 targetActivity：桌面 / 抽屉图标。
            桌面图标由单独的 alias 承载，隐藏图标只禁用 alias，MainActivity 本身仍在，
            不会出现「隐藏后连设置页都打不开」的自锁。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口。name 用完整类名，代码侧 LauncherIcon 里同名字符串 -->
        <activity-alias
            android:name="com.quietmap.app.LauncherEntry"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
