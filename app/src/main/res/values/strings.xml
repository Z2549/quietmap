<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">QuietMap</string>
    <string name="module_description">让高德地图安静下来：后台净化、数据层断源、收敛弹窗。</string>

    <!-- 界面外壳 -->
    <string name="about_title">关于 QuietMap</string>
    <string name="about_body">版本 %1$s\n后台净化 + 数据层断源 · libxposed API 102\n\n本模块与高德地图官方无任何关联，仅供学习、研究和个人设备使用。使用可能违反目标应用的服务条款，风险由使用者自行承担。\n\nMIT License\ngithub.com/yigenhuobah/quietmap</string>

    <!-- 顶部状态卡 -->
    <string name="status_title">模块状态</string>
    <string name="status_active">已激活</string>
    <string name="status_connected">框架已连接</string>
    <string name="status_inactive">未激活</string>
    <string name="status_connecting">正在连接框架…</string>
    <string name="status_detail_active">框架 API %1$d · 已注入高德 · v%2$s</string>
    <string name="status_detail_no_scope">框架 API %1$d · 作用域未勾选 com.autonavi.minimap · v%2$s</string>
    <string name="status_detail_not_running">框架 API %1$d · 启动高德后生效 · v%2$s</string>
    <string name="status_detail_connecting">绑定成功后自动刷新</string>
    <string name="status_remote_ok">remote prefs：可用，开关改动高德进程可读</string>
    <string name="status_remote_fail">remote prefs：不可用，开关暂存本地、当前不生效</string>

    <!-- 分组 -->
    <string name="group_splash">开屏净化</string>
    <string name="group_bg">后台净化</string>
    <string name="group_data">数据层断源</string>
    <string name="group_ui">界面</string>
    <string name="group_home">首页净化</string>
    <string name="group_search_promo">搜索与推广净化</string>

    <!-- 诊断卡 -->
    <string name="diag_title">诊断</string>
    <string name="diag_hint">registered=挂载成功 · hit N=命中次数 · skip=已跳过。数据来自高德进程回传，启动高德后约 3 秒刷新。</string>

    <!-- 页脚 -->
    <string name="footer_limits">仅保证高德 17.01.0.2012，其它版本尽力而为。</string>

    <!-- 功能标题与说明 -->
    <string name="f_splash_gate_title">开屏广告拦截</string>
    <string name="f_splash_gate_summary">开屏广告不再展示，启动直接进首页（双保险闸门）</string>
    <string name="f_splash_request_title">开屏广告请求断源</string>
    <string name="f_splash_request_summary">不发起开屏广告请求，省流量省电</string>
    <string name="f_splash_shake_title">摇一摇开屏禁用</string>
    <string name="f_splash_shake_summary">清空摇一摇引导与提示，摇一摇无从触发</string>
    <string name="f_bg_msg_fetch_title">后台消息拉取净化</string>
    <string name="f_bg_msg_fetch_summary">断开亮屏时后台拉取营销消息，并掐掉亮屏触发源</string>
    <string name="f_bg_awaken_report_title">唤端上报断源</string>
    <string name="f_bg_awaken_report_summary">不发送唤起端上报请求</string>
    <string name="f_bg_afc_taoke_title">淘宝客广告 SDK 断源</string>
    <string name="f_bg_afc_taoke_summary">阻止淘宝客广告 SDK 冷启动注册</string>
    <string name="f_bg_utdid_upload_title">设备指纹上传断源</string>
    <string name="f_bg_utdid_upload_summary">阻断 utdid 设备指纹的上传与服务端交换</string>
    <string name="f_h5_install_apk_title">H5 静默安装断源</string>
    <string name="f_h5_install_apk_summary">阻断 H5 页面静默下载并安装 APK</string>
    <string name="f_popup_upgrade_title">升级弹窗屏蔽</string>
    <string name="f_popup_upgrade_summary">不再弹出版本升级提示</string>
    <string name="f_home_banner_title">首页 Banner 断源</string>
    <string name="f_home_banner_summary">不拉取首页轮播 Banner，页面布局自适应留空</string>
    <string name="f_home_operate_bar_title">首页运营条与消息气泡屏蔽</string>
    <string name="f_home_operate_bar_summary">不展示首页运营活动条与地图消息气泡</string>
    <string name="f_home_msg_filter_title">首页消息红点净化</string>
    <string name="f_home_msg_filter_summary">数据层断源：不拉远程营销消息、不投主图、清角标红点。关闭本项可恢复消息列表拉取</string>
    <string name="f_search_hotword_title">搜索热词净化</string>
    <string name="f_search_hotword_summary">搜索框回退普通提示词，不请求、不展示轮播热词（不影响输入联想）</string>
    <string name="f_h5_ad_log_title">H5 广告监测断源</string>
    <string name="f_h5_ad_log_summary">阻断 H5 页面广告的点击与曝光上报</string>
    <string name="f_map_float_layer_title">地图浮层净化</string>
    <string name="f_map_float_layer_summary">不注册首页地图上的运营浮层挂件</string>
    <string name="f_msg_image_text_title">图文消息素材断源</string>
    <string name="f_msg_image_text_summary">不下载营销图文消息的图片与素材</string>
</resources>
